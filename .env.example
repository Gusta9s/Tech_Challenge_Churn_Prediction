# Todas as variaveis abaixo sao obrigatorias: as classes de configuracao em
# src/tech_challenge_churn_prediction/config/ nao possuem valores pre-setados,
# dependem exclusivamente do ambiente. Copie este arquivo para ".env" e
# ajuste os valores conforme o ambiente de execucao (os valores aqui sao
# apenas ilustrativos, nao necessariamente os reais usados em producao).

# AppSettings
APP_TITULO="Nome de exemplo da API"
APP_VERSAO="0.0.0-exemplo"

# LoggingSettings
LOG_NIVEL="DEBUG"
LOG_FORMATO="%(levelname)s %(message)s"

# ModelSettings
MODEL_DIRETORIO_MODELOS="caminho/de/exemplo/para/modelos"
MODEL_NOME_ARQUIVO_MODELO="modelo-exemplo.joblib"

# SecuritySettings (lista em formato JSON)
SECURITY_CAMPOS_SENSIVEIS=["campo_exemplo_um","campo_exemplo_dois"]
SECURITY_MASCARA_PADRAO="[OCULTO]"

# PredictionSettings
PREDICTION_LIMIAR_DECISAO_CHURN="0.42"

# RateLimitSettings
RATE_LIMIT_LIMITE_REQUISICOES="5"
RATE_LIMIT_JANELA_EM_SEGUNDOS="30"
RATE_LIMIT_CABECALHO_REQUISICOES_RESTANTES="X-Exemplo-Restantes"

# CorsSettings (listas em formato JSON)
CORS_ORIGENS_PERMITIDAS=["http://localhost:3000"]
CORS_METODOS_PERMITIDOS=["GET"]
CORS_CABECALHOS_PERMITIDOS=["Content-Type"]
CORS_PERMITIR_CREDENCIAIS="true"
