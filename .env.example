# Todas as variaveis abaixo sao obrigatorias: as classes de configuracao em
# src/tech_challenge_churn_prediction/config/ nao possuem valores pre-setados,
# dependem exclusivamente do ambiente. Copie este arquivo para ".env" e
# ajuste os valores conforme o ambiente de execucao.
#
# NOTA (avaliacao academica): os valores abaixo sao temporariamente os
# valores reais usados neste projeto, disponibilizados apenas para fins de
# avaliacao da banca do Tech Challenge. Em commits futuros serao revertidos
# para valores ilustrativos de exemplo.

# AppSettings
APP_TITULO="Tech Challenge Churn Prediction API"
APP_VERSAO="1.0.0"

# LoggingSettings
LOG_NIVEL="INFO"
LOG_FORMATO="%(asctime)s | %(levelname)s | %(name)s | %(message)s"

# ModelSettings
MODEL_DIRETORIO_MODELOS="models"
MODEL_NOME_ARQUIVO_MODELO="random_forest.joblib"

# SecuritySettings (lista em formato JSON)
SECURITY_CAMPOS_SENSIVEIS=["cobranca_mensal","total_cobrado_durante_trimestre"]
SECURITY_MASCARA_PADRAO="***"

# PredictionSettings
PREDICTION_LIMIAR_DECISAO_CHURN="0.5"

# RateLimitSettings
RATE_LIMIT_LIMITE_REQUISICOES="10"
RATE_LIMIT_JANELA_EM_SEGUNDOS="60"
RATE_LIMIT_CABECALHO_REQUISICOES_RESTANTES="X-RateLimit-Remaining"

# CorsSettings (listas em formato JSON)
CORS_ORIGENS_PERMITIDAS=["http://localhost:8001"]
CORS_METODOS_PERMITIDOS=["GET","POST"]
CORS_CABECALHOS_PERMITIDOS=["*"]
CORS_PERMITIR_CREDENCIAIS="false"
